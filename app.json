{
  "expo": {
    "name": "DripMaxx",
    "slug": "DripMaxx",
    "version": "1.0.1",
    "scheme": "acme",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-iap"
    ],
    "experiments": {
      "baseUrl": "/DripMaxx/"
    },
    "web": {
      "output": "single"
    },
    "android": {
      "package": "com.anonymous.DripMaxx",
      "jsEngine": "jsc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode" : 2
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.dripmaxx",
      "usesAppleSignIn": true
    },
    "extra": {
      "eas": {
        "projectId": "e2e8f183-5956-439e-82f1-8dbab7bc3428"
      }
    }
  }
}
