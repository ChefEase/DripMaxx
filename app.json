{
  "expo": {
    "name": "DripMaxx",
    "slug": "DripMaxx",
    "version": "1.0.3",
    "scheme": "acme",
    "sdkVersion": "54.0.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DripMaxx to access your photos so you can upload an outfit for analysis.",
          "cameraPermission": "Allow DripMaxx to use your camera so you can photograph an outfit for analysis.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/DripMaxx/"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "android": {
      "package": "com.anonymous.DripMaxx",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 26
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.dripmaxx",
      "buildNumber": "26",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "e2e8f183-5956-439e-82f1-8dbab7bc3428"
      }
    }
  }
}
